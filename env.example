# Copy to runtime/.env and replace every placeholder for local use.
DJANGO_SECRET_KEY=replace-with-local-secret
DJANGO_ALLOWED_HOST=localhost,127.0.0.1
DJANGO_DEBUG=True
POSTGRES_PASSWORD=replace-with-local-password
DJANGO_EMAIL_HOST_PASSWORD=replace-with-local-mail-password
IMAP_PASSWORD=replace-with-local-imap-password
STRIPE_API_SECRET=replace-with-test-secret
STRIPE_WEBHOOK_SECRET=replace-with-test-webhook-secret
STRIPE_PRICE_ID=replace-with-test-price-id
STRIPE_API_KEY_PUBLISHABLE=replace-with-test-publishable-key
MAIL_TEMPLATED_DOMAIN=http://localhost:8000
NOTIFICATION_TO_EMAIL=hello@kleeppr.com
